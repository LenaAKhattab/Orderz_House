# =============================================================================
# Orderz House — Stripe Sandbox recurring-renewal QA (DO NOT COMMIT REAL SECRETS)
# =============================================================================
# Copy to backend/.env.sandbox and fill locally. Never commit .env.sandbox.
#
# Load preference:
#   npm run qa:stripe-sandbox-renewal-ready
#   (auto-loads .env.sandbox when present)
#
# Or:
#   DOTENV_CONFIG_PATH=./.env.sandbox node scripts/qa/checkStripeSandboxRenewalReadiness.js
#
# CRITICAL:
# - Use sk_test_ / pk_test_ only
# - DATABASE_URL must be an ISOLATED Neon branch / local test DB
# - Never point this file at the shared Live Neon used for subscription 2396
# - Set ORDERZ_QA_ISOLATED_DB=1 only after the DB is confirmed isolated
# =============================================================================

PORT=5000
APP_ENV=sandbox
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Isolated DB only (Neon branch name should include sandbox|qa|test)
# Fail-closed: sandbox tooling must load .env.sandbox — never silently fall back to production .env
DATABASE_URL=postgresql://USER:PASSWORD@HOST/orderz_house_stripe_sandbox?sslmode=require
ORDERZ_QA_ISOLATED_DB=1

JWT_SECRET=local_sandbox_jwt_secret_16plus
JWT_EXPIRES_IN=7d

# Stripe TEST mode
STRIPE_SECRET_KEY=sk_test_...
# Publishable key (backend readiness + optional frontend mirror)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# From: stripe listen --forward-to localhost:5000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_...

# Attest that Stripe CLI forwarding is running before READY
STRIPE_CLI_FORWARD=0

# Email: keep non-production
EMAIL_DELIVERY_MODE=log
# EMAIL_DELIVERY_MODE=resend
# RESEND_API_KEY=

# Optional QA identity helpers
# ORDERZ_QA_FREELANCER_EMAIL=stripe-renewal-qa@local.test
