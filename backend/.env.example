# =============================================================================
# Orderz House ??? Backend environment template
# =============================================================================
# Copy to backend/.env and fill in real values in your host secret store.
# Never commit .env or paste production secrets into the repo.
#
# Environment guide:
#   local     ??? NODE_ENV=development, Stripe TEST keys, http://localhost:5173
#   staging   ??? NODE_ENV=production (or staging), Stripe TEST keys, HTTPS staging URLs
#   production ??? NODE_ENV=production, Stripe LIVE keys, HTTPS production URLs
#
# Database:
#   Use npm run db:migrate on staging/production.
#   Do NOT run sql/init.sql on staging/production ??? it DROPs tables (fresh dev only).
# =============================================================================

# --- Core server ---
PORT=5000
NODE_ENV=development

# Required always. Server exits if missing.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/orderz_house

# Required always. Minimum 16 characters.
JWT_SECRET=your_jwt_secret_at_least_16_characters
JWT_EXPIRES_IN=7d

# Canonical SPA origin (single URL). Used for Stripe success/cancel redirects and CORS.
# Production: one origin only ??? no commas. Use CORS_ORIGINS for www/apex/preview extras.
# Local:     http://localhost:5173
# Staging:   https://staging.your-domain.com
# Production: https://your-domain.com
CLIENT_URL=http://localhost:5173

# Public API origin for mobile Stripe return bridge (not the SPA).
# Stripe redirects to: {BACKEND_PUBLIC_URL}/mobile/payment-return?...
# Local:      http://localhost:5000 (OK for Stripe CLI / desktop)
# Production: https://orderzhouse.com  ??? NEVER localhost or 10.0.2.2
# If unset in production, HTTPS CLIENT_URL origin is used as fallback.
# BACKEND_PUBLIC_URL=https://orderzhouse.com
# BACKEND_PUBLIC_URL=http://localhost:5000

# Custom URL scheme for Flutter deep link after bridge (default: orderzhouse).
# MOBILE_APP_SCHEME=orderzhouse

# Optional comma-separated extra browser origins (www, apex, preview deploys).
# CORS_ORIGINS=https://www.your-domain.com,https://preview.your-domain.com

# --- Required when NODE_ENV=production (staging + production API hosts) ---
# Local: use sk_test_... and stripe listen for webhooks.
# Production: use sk_live_... only — never mix live keys on local machines.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Optional publishable key for QA readiness / tooling (frontend may use VITE_STRIPE_PUBLISHABLE_KEY):
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
#
# Stripe Sandbox recurring-renewal QA (isolated Neon branch — NEVER shared Live DB):
#   Copy backend/.env.sandbox.example → backend/.env.sandbox
#   npm run qa:stripe-sandbox-renewal-ready
#   stripe listen --forward-to localhost:5000/api/webhooks/stripe
#   Set STRIPE_CLI_FORWARD=1 after listen is running
#   ORDERZ_QA_ISOLATED_DB=1 only when DATABASE_URL is a dedicated sandbox/test branch
# Do not reuse Live subscription 2396 / user 3706 for Sandbox QA.

# --- Cookies & HTTPS (staging/production behind reverse proxy) ---
# Secure cookie defaults to true when NODE_ENV=production.
# Local HTTP with NODE_ENV=production testing: COOKIE_SECURE=0
# COOKIE_SECURE=0

# Use COOKIE_SAME_SITE=none when SPA and API are on different sites (e.g. app.example.com
# + api.example.com) AND both use HTTPS. Requires Secure cookies. Same host: omit or lax.
# COOKIE_SAME_SITE=none

# Set TRUST_PROXY=1 when API runs behind Render/Railway/Fly/nginx (rate limits + client IP).
# TRUST_PROXY=1

# --- General API rate limit (Stripe webhook + /health + /auth/* + dedicated order writes are excluded) ---
# API_RATE_LIMIT_WINDOW_MS=900000
# API_RATE_LIMIT_MAX=450
# API_RATE_LIMIT_MAX=0 disables general limiter only (auth + order-write limiters still apply).

# --- Order / bid / admin write limiters (per authenticated user; IP fallback for guests) ---
# ORDER_CREATE_CLIENT_MAX_PER_MIN=5
# ORDER_CREATE_CLIENT_MAX_PER_HOUR=25
# ORDER_CREATE_ADMIN_MAX_PER_MIN=20
# ORDER_BID_TAKE_MAX_PER_MIN=15
# TRAINING_BULK_GENERATE_MAX_PER_5MIN=3
# ADMIN_WRITE_MAX_PER_MIN=60
# NOTIFICATIONS_READ_MAX_PER_MIN=120

# --- Translation ---
# TRANSLATION_RATE_LIMIT_MAX=120

# --- Email — Resend (register OTP, forgot/reset password) ---
# Local development (recommended): mock delivery — OTP is printed only on the backend console.
# EMAIL_DELIVERY_MODE=mock is ignored when NODE_ENV=production (never weakens production).
EMAIL_DELIVERY_MODE=mock
# Leave RESEND_API_KEY empty (or commented) for local mock. Set a verified-domain key for real sends.
# RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM="Orderz House <no-reply@example.com>"
# EMAIL_REPLY_TO=support@example.com
#
# Staging/production: NODE_ENV=production, EMAIL_DELIVERY_MODE unset or "resend",
# RESEND_API_KEY required (full-access or verified-domain key matching EMAIL_FROM).

# --- Cloudinary (profile avatar, order files, ads, courses) ---
# Required before any upload feature is tested on staging/production.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- PostHog (optional ??? server-side analytics / HogQL for super-admin dashboards) ---
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://us.i.posthog.com
# POSTHOG_PROJECT_ID=
# POSTHOG_PERSONAL_API_KEY=

# --- Stripe local webhook forwarding ---
# stripe listen --forward-to localhost:5000/api/webhooks/stripe
# Production webhook URL: https://<API_HOST>/api/webhooks/stripe
# Events (recurring + checkout): checkout.session.completed,
#   invoice.paid, invoice.payment_succeeded, invoice.payment_failed,
#   customer.subscription.updated, customer.subscription.deleted,
#   payment_intent.succeeded, payment_intent.payment_failed
# Sandbox QA attestation after listen is running:
# STRIPE_CLI_FORWARD=1
# ORDERZ_QA_WEBHOOK_FORWARD_READY=1

# --- Debug (never in production) ---
# When true + non-production NODE_ENV, API errors may include debug.message/stack.
EXPOSE_ERROR_DEBUG=false
# DEBUG_FREELANCER_CHECKOUT=1

# --- Fake training orders automation ---
# Round duration & scheduled rotation interval: Super Admin ??? Training settings
#   fake_order_settings.duration_value + duration_unit (default 12 hours from migration 030).
# FAKE_ORDERS_TICK_MS = how often runAutomationTick runs (default 60s) ??? NOT round length.
#
# Non-production: in-process ticks ON by default (single local backend).
# Production (single instance): FAKE_ORDERS_AUTOMATION_ENABLED=true
# Production (multi-instance): external cron every 1???2 min:
#   POST https://<API_HOST>/api/internal/fake-orders/automation-tick
#   Header: X-Fake-Orders-Automation-Secret: <FAKE_ORDERS_AUTOMATION_CRON_SECRET>
# Also enable automation in Super Admin ??? Training settings (automation_enabled).
#
# FAKE_ORDERS_AUTOMATION_ENABLED=false
# FAKE_ORDERS_TICK_MS=60000
# FAKE_ORDERS_AUTOMATION_VERBOSE=false
# FAKE_ORDERS_AUTOMATION_CRON_SECRET=
# FAKE_ORDERS_OVERLAP_MS=300000

# --- Institutional order storage release scheduler (independent from fake/training rotation) ---
# Non-production: in-process ticks ON by default (single local backend).
# Production: set INSTITUTIONAL_RELEASE_SCHEDULER_ENABLED=true on ONE worker only,
#   OR disable the in-process scheduler and call manual tick from external cron:
#   POST /api/admin/institutional-order-storage/release-tick (staff + retry permission)
# Do NOT enable both competing drivers on multiple instances without advisory-lock awareness
# (ticks use pg_try_advisory_lock(913847201) + SKIP LOCKED).
# Verify: GET /api/admin/institutional-order-storage/scheduler/health
# Also see docs/institutional-release-scheduler.md
#
# INSTITUTIONAL_RELEASE_SCHEDULER_ENABLED=false
# INSTITUTIONAL_RELEASE_TICK_MS=60000

# --- Translation API (optional ??? dynamic Arabic???English for CMS/FAQ; static UI uses locale JSON) ---
# Provider: deepl (default) or openai. Keys never exposed to the browser.
# DEEPL_API_KEY=your_deepl_key
# TRANSLATION_API_KEY=           # alias for DEEPL_API_KEY or OpenAI sk-...
# TRANSLATION_PROVIDER=deepl     # deepl | openai
# TRANSLATION_OPENAI_MODEL=gpt-4o-mini
# TRANSLATION_RATE_LIMIT_MAX=120

# --- Firebase Cloud Messaging (optional mobile push) ---
# Leave unset to keep in-app notifications only (push is skipped safely).
# Prefer JSON path on the server; do not commit the service-account file.
# FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
# Or inline JSON (escape carefully in process managers):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# --- FAZ3AT workforce provider (backend-to-backend only) ---
# Enable only on staging/local until FAZAT cutover. Never expose secrets to browsers/mobile.
# FAZAT_INTEGRATION_ENABLED=false
# FAZAT_INTEGRATION_API_KEY=replace_with_long_random_partner_key
# FAZAT_INTEGRATION_SHARED_SECRET=replace_with_long_random_hmac_secret
# FAZAT_WEBHOOK_URL=https://fazat.example/webhooks/orderz
# ORDERZ_PUBLIC_API_URL=http://localhost:5000
# FAZAT_INTEGRATION_ACTOR_USER_ID=   # optional admin/super_admin user id used to create internal orders
# FAZAT_DEFAULT_CATEGORY_ID=         # optional fallback category for partner order create
# FAZAT_REQUEST_MAX_SKEW_SEC=300
# FAZAT_QA_LIVE=0                    # set 1 only for optional live smoke in npm run qa:fazat-integration
# FAZAT_ALLOW_REMOTE_STAGING_DB=0    # never set 1 against production; staging Neon only with confirm
# FAZAT_SEED_CONFIRM=                # must equal STAGING to seed remote staging DB
# Live schema-only (OWNER APPROVAL). Allows migrate:fazat-safe ONLY — never seed/E2E. Unset after use.
# FAZAT_ALLOW_LIVE_SCHEMA_ROLLOUT=false
# FAZAT_LIVE_SCHEMA_CONFIRM=         # must equal LIVE_SCHEMA_ONLY with the flag above
# See docs/integrations/FAZAT_LIVE_DB_ROLLOUT.md
# Controlled live pilot (comma-separated freelancer user ids). Required when FAZAT_INTEGRATION_ENABLED=true.
# FAZAT_PILOT_FREELANCER_IDS=
# FAZAT_PILOT_RANK_CONFIRM=          # PILOT_RANK for scripts/setFazatPilotRank.js
# FAZAT_ENABLE_PARTNER_CONFIRM=      # ENABLE_FAZAT_PARTNER for scripts/enableFazatPartner.js
# FAZAT_SEED_UNAPPROVED_ID=
# FAZAT_SEED_APPROVED_ID=
# FAZAT_SEED_TRUSTED_ID=

# --- Optional diagnostics ---
# HEALTH_RUNTIME_DIAGNOSTICS=1  # production: expose runtime.nodeEnv on GET /api/health

# SLOW_REQUEST_LOG_MS=1500
# LOG_ALL_REQUEST_TIMING=0
# DASHBOARD_SECTION_TIMEOUT_MS=5000
# TRAINING_POOL_DEBUG=0
