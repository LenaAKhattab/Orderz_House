# =============================================================================
# Orderz House — Backend environment template
# =============================================================================
# Copy to backend/.env and fill in real values in your host secret store.
# Never commit .env or paste production secrets into the repo.
#
# Environment guide:
#   local     — NODE_ENV=development, Stripe TEST keys, http://localhost:5173
#   staging   — NODE_ENV=production (or staging), Stripe TEST keys, HTTPS staging URLs
#   production — NODE_ENV=production, Stripe LIVE keys, HTTPS production URLs
#
# Database:
#   Use npm run db:migrate on staging/production.
#   Do NOT run sql/init.sql on staging/production — it DROPs tables (fresh dev only).
# =============================================================================

# --- Core server ---
PORT=5000
NODE_ENV=development

# Required always. Server exits if missing.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/orderz_house

# Required always. Minimum 16 characters.
JWT_SECRET=your_jwt_secret_at_least_16_characters
JWT_EXPIRES_IN=7d

# Canonical SPA origin (single URL). Used for Stripe success/cancel redirects and CORS.
# Production: one origin only — no commas. Use CORS_ORIGINS for www/apex/preview extras.
# Local:     http://localhost:5173
# Staging:   https://staging.your-domain.com
# Production: https://your-domain.com
CLIENT_URL=http://localhost:5173

# Optional comma-separated extra browser origins (www, apex, preview deploys).
# CORS_ORIGINS=https://www.your-domain.com,https://preview.your-domain.com

# --- Required when NODE_ENV=production (staging + production API hosts) ---
# Local: use sk_test_... and stripe listen for webhooks.
# Production: use sk_live_... only — never mix live keys on local machines.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# --- Cookies & HTTPS (staging/production behind reverse proxy) ---
# Secure cookie defaults to true when NODE_ENV=production.
# Local HTTP with NODE_ENV=production testing: COOKIE_SECURE=0
# COOKIE_SECURE=0

# Use COOKIE_SAME_SITE=none when SPA and API are on different sites (e.g. app.example.com
# + api.example.com) AND both use HTTPS. Requires Secure cookies. Same host: omit or lax.
# COOKIE_SAME_SITE=none

# Set TRUST_PROXY=1 when API runs behind Render/Railway/Fly/nginx (rate limits + client IP).
# TRUST_PROXY=1

# --- General API rate limit (Stripe webhook + /health are excluded) ---
# API_RATE_LIMIT_WINDOW_MS=900000
# API_RATE_LIMIT_MAX=300
# API_RATE_LIMIT_MAX=0 disables general limiter only (auth limiters still apply).

# --- Email — Resend (register OTP, forgot/reset password) ---
# Optional in local dev (OTP may not send). Required for real auth E2E on staging/production.
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM="Orderz House <no-reply@example.com>"

# --- Cloudinary (profile avatar, order files, ads, courses) ---
# Required before any upload feature is tested on staging/production.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- PostHog (optional — server-side analytics / HogQL for super-admin dashboards) ---
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://us.i.posthog.com
# POSTHOG_PROJECT_ID=
# POSTHOG_PERSONAL_API_KEY=

# --- Stripe local webhook forwarding ---
# stripe listen --forward-to localhost:5000/api/webhooks/stripe
# Production webhook URL: https://<API_HOST>/api/webhooks/stripe
# Events: checkout.session.completed, payment_intent.succeeded, payment_intent.payment_failed

# --- Debug (never in production) ---
# When true + non-production NODE_ENV, API errors may include debug.message/stack.
EXPOSE_ERROR_DEBUG=false
# DEBUG_FREELANCER_CHECKOUT=1

# --- Fake training orders automation (default OFF — safe for multi-instance production) ---
# Do not enable FAKE_ORDERS_AUTOMATION_ENABLED on more than one Node instance.
# Prefer external cron: POST /api/internal/fake-orders/automation-tick
# Header: X-Fake-Orders-Automation-Secret (min 16 chars, not a placeholder).
FAKE_ORDERS_AUTOMATION_ENABLED=false
# FAKE_ORDERS_TICK_MS=60000
# FAKE_ORDERS_AUTOMATION_VERBOSE=false
# FAKE_ORDERS_AUTOMATION_CRON_SECRET=

# --- Optional diagnostics ---
# SLOW_REQUEST_LOG_MS=1500
# LOG_ALL_REQUEST_TIMING=0
# DASHBOARD_SECTION_TIMEOUT_MS=5000
# TRAINING_POOL_DEBUG=0
