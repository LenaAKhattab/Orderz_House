# Orderz House — Staging only (Neon branch: staging-ord20)
# Copy to backend/.env.staging and fill in branch connection strings.
# Never commit backend/.env.staging. Production stays in backend/.env (unchanged).
#
# Local Staging QA (do NOT use plain `npm start`):
#   npm run qa:staging:preflight
#   npm run start:staging

APP_ENV=staging
CLIENT_URL=http://localhost:5174
# Prefer a writable Staging connection (direct host). Neon -pooler URLs may set
# default_transaction_read_only=on and block login/push-token/deletes.
# Never use Production host (ep-wandering-cherry…).
DATABASE_URL=postgresql://STAGING_DATABASE_URL_HERE
DIRECT_URL=postgresql://STAGING_DIRECT_URL_HERE
