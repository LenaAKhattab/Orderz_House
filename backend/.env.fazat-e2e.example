# Orderz House — FAZAT local/staging E2E env (EXAMPLE ONLY)
# Copy to backend/.env.fazat-e2e and fill values. Never commit real secrets.
# Load with:  node -r dotenv/config server.js dotenv_config_path=.env.fazat-e2e
# Or merge into a dedicated local .env that does NOT point at production Neon.

NODE_ENV=development
PORT=5000

# --- SAFE DB ONLY (localhost or dedicated staging branch) ---
# Do NOT paste the live Neon production URL here.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/orderz_fazat_e2e

# Required by app boot (use local/dev values; not production JWT)
JWT_SECRET=replace_with_local_dev_jwt_secret_min_32_chars
CLIENT_URL=http://localhost:5173

# --- FAZAT workforce provider ---
FAZAT_INTEGRATION_ENABLED=true
FAZAT_INTEGRATION_API_KEY=replace_me_partner_key
FAZAT_INTEGRATION_SHARED_SECRET=replace_me_32_chars_min_hmac_secret
FAZAT_WEBHOOK_URL=http://localhost:3000/api/v1/integrations/orderz/webhooks
ORDERZ_PUBLIC_API_URL=http://localhost:5000
FAZAT_INTEGRATION_ACTOR_USER_ID=replace_with_admin_user_id
FAZAT_DEFAULT_CATEGORY_ID=replace_with_category_id
FAZAT_REQUEST_MAX_SKEW_SEC=300

# Safety: leave unset/0 for local. Remote staging only with both:
# FAZAT_ALLOW_REMOTE_STAGING_DB=0
# FAZAT_SEED_CONFIRM=
FAZAT_QA_LIVE=0
