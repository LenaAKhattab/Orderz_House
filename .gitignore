# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Environment files (never commit secrets)
.env
.env.local
.env.staging
.env.development
.env.production
*.env.local
backend/.env
backend/.env.local
backend/.env.staging
backend/.env.sandbox
frontend/.env
frontend/.env.local
frontend/.env.production
frontend/.env.development
# Keep example templates trackable
!.env.example
!.env.*.example
!backend/.env.example
!backend/.env.*.example
!frontend/.env.example
!frontend/.env.*.example
!mobile/**/.env.example
!mobile/**/.env.*.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build artifacts
frontend/dist/
coverage/
**/coverage/

# Local agent/test scratch (logs, screenshots, QA reports — never commit)
backend/.tmp/
backend/.tmp/**

# OS files
.DS_Store
Thumbs.db

# Local private uploads (orders, KYC ID images — never commit)
backend/uploads/
backend/uploads/**

# Mobile release artifacts (never commit binaries)
*.apk
*.aab
*.ipa
*.apk.sha1

backend/google/service-account.json
backend/secrets/
# Firebase / GCP service accounts (never commit — any path, any double .json typo)
firebase-service-account*.json
**/firebase-service-account*.json
**/serviceAccount*.json
backend/**/firebase-service-account*.json
backend/**/serviceAccount*.json
backend/data/translation-cache.json
mobile/orderzhouse_app/android/app/google-services.json
mobile/orderzhouse_app/ios/Runner/GoogleService-Info.plist
mobile/orderzhouse_app/lib/firebase_options.dart

# --- Secrets / migration material guard (2026-11-26) ---
# Firebase Admin SDK + generic service-account keys (backend credential lives on the VPS host only)
*firebase-adminsdk*.json
*service-account*.json
*serviceAccount*.json
# SSH private keys
id_rsa
id_ed25519
id_ecdsa
*_ed25519
*_rsa
*.pem
*.p12
# Build artifacts, migration archives and local logs
/artifacts/
/backend/logs/
*.7z
*.tar.gz
