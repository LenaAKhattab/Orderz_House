# =============================================================================
# Orderz House — Frontend environment template (Vite)
# =============================================================================
# Copy to frontend/.env or frontend/.env.local — never commit real secrets.
#
# Environment guide:
#   local     — http://localhost:5000/api, PostHog usually off in dev
#   staging   — https://<API_HOST>/api, VITE_POSTHOG_* for staging project
#   production — production API URL, PostHog production project key
#
# VITE_API_BASE_URL must match backend CLIENT_URL / CORS_ORIGINS (browser origin).
# =============================================================================

# Backend API base URL — must include /api suffix.
# Local:    http://localhost:5000/api
# Staging:  https://api.staging.your-domain.com/api
# Production: https://api.your-domain.com/api
VITE_API_BASE_URL=http://localhost:5000/api

# Optional: JOD → EGP display rate for Egypt visitors on /plans (display only; checkout stays JOD).
# VITE_JOD_TO_EGP_RATE=70.5

# PostHog — browser project key only (phc_...). Never put personal API keys here.
# Tracking runs in production builds, or in dev when VITE_POSTHOG_ENABLE_IN_DEV=true.
# VITE_POSTHOG_KEY=phc_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Ingestion host (not app.posthog.com dashboard URL):
# VITE_POSTHOG_HOST=https://us.i.posthog.com
# VITE_POSTHOG_ENABLE_IN_DEV=false
