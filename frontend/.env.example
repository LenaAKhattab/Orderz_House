# Optional. Default is /api (same-origin).
# Local Vite proxies /api and /images to http://localhost:5000
# Production builds should use /api (see Dockerfile ARG).
# VITE_API_BASE_URL=/api

# Optional analytics
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://us.i.posthog.com
# VITE_POSTHOG_ENABLE_IN_DEV=false
