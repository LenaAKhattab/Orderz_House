# Orderz House Flutter — API base URL (includes /api suffix).
# Copy for local overrides (NOT bundled in release APK):
#   cp .env.example .env
#   flutter run --dart-define-from-file=.env
#
# Release builds ignore .env — use --dart-define or production HTTPS fallback.
# See docs/MOBILE_RELEASE.md
# Android Emulator:
#   API_BASE_URL=http://10.0.2.2:5000/api
#
# iOS Simulator / Desktop:
#   API_BASE_URL=http://localhost:5000/api
#
# Physical device (same Wi‑Fi as your computer):
#   API_BASE_URL=http://YOUR_COMPUTER_IP:5000/api
#
# Production (verified Phase 5E-PREP — health at /api/health):
#   API_BASE_URL=https://orderzhouse.com/api
#
# Override without editing .env:
#   flutter run --dart-define=API_BASE_URL=http://192.168.1.10:5000/api

API_BASE_URL=http://10.0.2.2:5000/api

# Public web app (freelancer subscription opens in external browser):
# Android Emulator (default below):
#   WEB_BASE_URL=http://10.0.2.2:5173
# iOS Simulator / Desktop:
#   WEB_BASE_URL=http://localhost:5173
# Production:
#   WEB_BASE_URL=https://orderzhouse.com
# Override:
#   flutter run --dart-define=WEB_BASE_URL=https://orderzhouse.com

WEB_BASE_URL=http://10.0.2.2:5173
